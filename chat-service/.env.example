# --- Chat service ---
NODE_ENV=development
PORT=3002

# MongoDB (local, hors Docker)
MONGO_URI=mongodb://localhost:27017/heroverse_chat

# Origines autorisées (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# --- JWT (doit correspondre à auth-service) ---
JWT_ISSUER=heroverse-auth
JWT_AUDIENCE=heroverse-services

# Clé publique RS256 de l'auth-service.
# Lancé depuis chat-service/ : ../auth-service/keys/public.pem
# Dans Docker, cette variable est surchargée par /app/keys/public.pem
JWT_PUBLIC_KEY_PATH=../auth-service/keys/public.pem

# Alternative : clé PEM directement en variable d'environnement (cloud).
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Nombre maximum de messages renvoyés par l'historique
MESSAGE_HISTORY_LIMIT=100

# --- Docker Compose ---
CHAT_PORT=3002
MONGO_DB=heroverse_chat
